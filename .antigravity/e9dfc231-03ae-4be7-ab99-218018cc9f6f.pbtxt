        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    this.droneLfo.connect(this.droneLfoGain);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    this.droneLfoGain.connect(this.droneFilter.frequency);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    this.droneOsc1.connect(this.droneFilter);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }

          text: "    seenIds.add(uId);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return { ...h, id: uId };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return filtered.sort((a, b) => parseTimeStartInMins(a.timeBlock) - parseTimeStartInMins(b.timeBlock));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export function generateProceduralAnalysis(stats: any, archetypeData: any, habitMastery: any, currentTasks: any[]): string {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const arch = getArchetypeProfile(archetypeData, stats?.characterClass);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const level = stats?.level || 1;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const rank = stats?.rankTitle || \"Chispazo de Voluntad\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const streak = stats?.currentStreak || stats?.streakDays || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const coins = stats?.coins || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const pending = (currentTasks || []).filter((t: any) => !t.completed);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const habitCount = Object.keys(habitMastery || {}).length;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let streakMsg = \"\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (streak >= 7) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    streakMsg = `\342\232\241 **TELEMETR\303\215A DE PERSISTENCIA:** Vector de continuidad en **${streak} ciclos consecutivos**. Estabilidad operacional: \303\223ptima. La inercia biol\303\263gica ha sido temporalmente suprimida.`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  } else if (streak >= 3) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    streakMsg = `\342\232\240\357\270\217 **TELEMETR\303\215A DE PERSISTENCIA:** Vector activo de **${streak} ciclos**. Registro vulnerable. La complacencia en esta fase reiniciar\303\241 tus contadores a cero. Prohibido bajar la frecuencia.`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  } else {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    streakMsg = `\360\237\232\250 **TELEMETR\303\215A DE PERSISTENCIA:** Inestabilidad cr\303\255tica. Ciclo en umbral cero o inferior a 3 d\303\255as. El sistema detecta resistencia biol\303\263gica y excusas cognitivas. Requiere ignici\303\263n inmediata.`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let habitMsg = habitCount > 0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ? `\360\237\247\254 **SUBRUTINAS EN EJECUCI\303\223N:** Detectadas **${habitCount} subrutinas de h\303\241bitos** registradas en memoria flash. El protocolo exige repetici\303\263n exacta: a los 21 ciclos se forja la neuroplasticidad b\303\241sica; a los 66 ciclos se alcanza la soberan\303\255a cognitiva.`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    : `\360\237\247\254 **ALERTA DE SUBRUTINAS:** Cero h\303\241bitos recurrentes detectados. Operas en modo ca\303\263tico manual. Incorpora 1 o 2 protocolos esenciales de inmediato: ${arch.strategy}`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let taskMsg = pending.length > 0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ? `\342\232\224\357\270\217 **COLA DE EJECUCI\303\223N:** Tienes **${pending.length} directivas pendientes** en el hilo principal. ${arch.strategy} La postergaci\303\263n ser\303\241 tratada como fuga de recursos. Bloquea est\303\255mulos, activa el cron\303\263metro y purga la lista ahora.`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    : `\360\237\233\241\357\270\217 **ESTADO DEL SISTEMA:** Hilo de ejecuci\303\263n despejado. Todas las directivas del ciclo han sido compiladas. Ejecuta mantenimiento nocturno y prep\303\241rate para la siguiente sobrecarga de datos.`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return `\360\237\244\226 **[SISTEMA CENTRAL // LA SOLUCI\303\223N CORE]**\\n\\n**IDENTIFICACI\303\223N:** Operador **${rank}** (Nivel ${level})\\n**MATRIZ ARQUET\303\215PICA:** ${arch.avatar} ${arch.title.toUpperCase()} // Vector: \"${arch.desire}\"\\n\\n${streakMsg}\\n\\n\342\232\231\357\270\217 **DIRECTIVA QUIR\303\232RGICA:** ${arch.wisdom}\\n\\n\360\237\233\221 **VULNERABILIDAD DEL OPERADOR (PURGAR INMEDIATAMENTE):** ${arch.shadowTrap}\\n\\n${habitMsg}\\n\\n${taskMsg}\\n\\n---\\n*Compilado por La Soluci\303\263n Core // Cr\303\251ditos de c\303\263mputo: ${coins} cr\303\251ditos.*`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
    overwrite: true
  }
}

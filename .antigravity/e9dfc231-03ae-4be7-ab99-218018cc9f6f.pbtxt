    content: "{\n  \"name\": \"react-example\",\n  \"private\": true,\n  \"version\": \"0.0.0\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"tsx server.ts\",\n    \"build\": \"vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs\",\n    \"start\": \"node dist/server.cjs\",\n    \"clean\": \"rm -rf dist\",\n    \"lint\": \"tsc --noEmit\"\n  },\n  \"dependencies\": {\n    \"@google/genai\": \"^2.4.0\",\n    \"@tailwindcss/vite\": \"^4.1.14\",\n    \"@types/canvas-confetti\": \"^1.9.0\",\n    \"@vitejs/plugin-react\": \"^5.0.4\",\n    \"canvas-confetti\": \"^1.9.4\",\n    \"dotenv\": \"^17.2.3\",\n    \"express\": \"^4.21.2\",\n    \"firebase\": \"^12.18.0\",\n    \"lucide-react\": \"^0.546.0\",\n    \"motion\": \"^12.23.24\",\n    \"react\": \"^19.0.1\",\n    \"react-dom\": \"^19.0.1\",\n    \"recharts\": \"^3.10.1\",\n    \"vite\": \"^6.2.3\",\n    \"zustand\": \"^5.0.15\"\n  },\n  \"devDependencies\": {\n    \"@firebase/eslint-plugin-security-rules\": \"^0.0.2\",\n    \"@types/express\": \"^4.17.21\",\n    \"@types/node\": \"^22.14.0\",\n    \"autoprefixer\": \"^10.4.21\",\n    \"esbuild\": \"^0.25.0\",\n    \"tailwindcss\": \"^4.1.14\",\n    \"tsx\": \"^4.21.0\",\n    \"typescript\": \"~5.8.2\",\n    \"vite\": \"^6.2.3\",\n    \"vite-plugin-pwa\": \"^1.3.0\"\n  }\n}\n"

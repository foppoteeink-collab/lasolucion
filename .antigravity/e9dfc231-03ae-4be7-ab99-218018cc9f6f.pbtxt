s: ^3.10.1\nvite: ^6.2.3\nzustand: ^5.0.15\n\nThe following devDependencies are installed:\n@firebase/eslint-plugin-security-rules: ^0.0.2\n@types/express: ^4.17.21\n@types/node: ^22.14.0\nautoprefixer: ^10.4.21\nesbuild: ^0.25.0\ntailwindcss: ^4.1.14\ntsx: ^4.21.0\ntypescript: ~5.8.2\nvite: ^6.2.3\nvite-plugin-pwa: ^1.3.0\n\nKey file contents:\n\n--- /.env.example ---\n```\n# GEMINI_API_KEY: Required for Gemini AI API calls.\n# AI Studio automatically injects this at runtime from user secrets.\n# Users configure this via the Secrets panel in the AI Studio UI.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# APP_URL: The URL where this applet is hosted.\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\n# Used for self-referential links, OAuth callbacks, and API endpoints.\nAPP_URL=\"MY_APP_URL\"\n\n```\n\n--- /firebase-applet-config.json ---\n```json\n{\n  \"projectId\": \"gen-lang-client-0057427672\",\n  \"appId\": \"1:110128261056:web:401f449c70fa0043070a25\",\n  \"apiKey\": \"AIzaSyCzuhQ134jh9t4L_OiclFDVohNFwiZZ1pI\",\n  \"authDomain\": \"gen-lang-client-0057427672.firebaseapp.com\",\n  \"firestoreDatabaseId\": \"ai-studio-remixlasolucion1-e9dfc231-03ae-4be7-ab99-218018cc9f6f\",\n  \"storageBucket\": \"gen-lang-client-0057427672.firebasestorage.app\",\n  \"messagingSenderId\": \"110128261056\",\n  \"measurementId\": \"\",\n  \"oAuthClientId\": \"110128261056-fi2d8dsp728scie9bfrri28oin67tn1k.apps.googleusercontent.com\",\n  \"recaptchaSiteKey\": \"\"\n}\n```\n\n--- /index.html ---\n```html\n<!doctype html>\n<html lang=\"es\" class=\"h-full dark\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta\n      name=\"viewport\"\n      content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover\"\n    />\n    <title>La Soluci\303\263n - RPG de H\303\241bitos & Productividad</title>\n    <meta name=\"description\" content=\"Transforma tu rutina, h\303\241bitos y pomodoro en una aventura \303\251pica con est\303\251tica Solo Leveling, misiones, smart recall, bit\303\241cora y recompensas.\" />\n    <meta property=\"og:title\" content=\"La Soluci\303\263n - RPG de H\303\241bitos & Productividad\" />\n    <meta property=\"og:description\" content=\"Transforma tu rutina, h\303\241bitos y pomodoro en una aventura \303\251pica con est\303\251tica Solo Leveling, misiones, smart recall, bit\303\241cora y recompensas.\" />\n    <meta name=\"theme-color\" content=\"#000000\" />\n    <meta name=\"mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\" />\n    <meta name=\"apple-mobile-web-app-title\" content=\"La Soluci\303\263n\" />\n    <link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/icon.svg\" />\n    <link rel=\"manifest\" href=\"/manifest.webmanifest\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Anton&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n    <script>\n      // Filter out expected/benign Vite HMR websocket reconnection notices in sandboxed iframe\n      (function() {\n        function shouldSuppress(args) {\n          try {\n            for (var i = 0; i < args.length; i++) {\n              var str = typeof args[i] === \'string\' ? args[i] : (args[i] && args[i].message ? args[i].message : String(args[i]));\n              if (str && (str.indexOf(\'[vite]\') !== -1 || str.indexOf(\'WebSocket\') !== -1 || str.indexOf(\'failed to connect to websocket\') !== -1)) {\n                return true;\n              }\n            }\n          } catch(e) {}\n          return false;\n        }\n\n        [\'error\', \'warn\', \'info\', \'log\'].forEach(function(method) {\n          var orig = console[method];\n          console[method] = function() {\n            if (shouldSuppress(arguments)) return;\n            return orig.apply(console, arguments);\n          };\n        });\n\n        window.addEventListener(\'error\', function(event) {\n          if (event && event.message && (event.message.indexOf(\'[vite]\') !== -1 || event.message.indexOf(\'WebSocket\') !== -1)) {\n            event.stopImmediatePropagation();\n            event.preventDefault();\n          }\n        }, true);\n\n        window.addEventListener(\'unhandledrejection\', function(event) {\n          if (event && event.reason) {\n            var reasonStr = typeof event.reason === \'string\' ? event.reason : (event.reason.message || String(event.reason));\n            if (reasonStr && (reasonStr.indexOf(\'[vite]\') !== -1 || reasonStr.indexOf(\'WebSocket\') !== -1)) {\n              event.stopImmediatePropagation();\n              event.preventDefault();\n            }\n          }\n        }, true);\n      })();\n    </script>\n  </head>\n  <body class=\"h-full antialiased font-sans bg-[#000000] text-white selection:bg-[#d6f421] selection:text-black transition-colors duration-300\">\n    <div id=\"root\" class=\"h-full\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"Remix La Solucion 18 sep y ultimo\",\n  \"description\": \"Gamified productivity app with level-up system, daily rewards, pomodoro timer, weekly stats, Google Drive backup architecture, and push notifications.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/App.tsx ---\n```typescript\n\nimport React from \'react\';\nimport { AppLayout } from \'./components/AppLayout\';\nimport { TimerProvider } from \'./context/TimerContext\';\n\nexport default function App() {\n  return (\n    <TimerProvider>\n      <AppLayout />\n    </TimerProvider>\n  );\n}\n\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n@import url(\'https://fonts.googleapis.com/css2?family=Anton&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap\');\n@custom-variant dark (&:where(.dark, .dark *));\n\n@layer base {\n  :root {\n    font-family: \'Plus Jakarta Sans\', system-ui, -apple-system, sans-serif;\n    color-scheme: dark;\n    background-color: #000000;\n  }\n\n  html, body, #root {\n    background-color: #000000 !important;\n    color: #ffffff !important;\n    min-height: 100%;\n  }\n  \n  h1, h2, h3, h4, h5, h6, .font-display, .font-anton {\n    font-family: \'Anton\', \'Outfit\', system-ui, sans-serif !important;\n    letter-spacing: 0.04em;\n  }\n}\n\n/* Force pure dark background everywhere and eradicate light mode remnants */\n#main-layout-wrapper {\n  background-color: #000000 !important;\n  color: #ffffff !important;\n}\n\n/* --- PROTOCOLO CIENT\303\215FICO Y ERRADICACI\303\223N EST\303\211TICA: MATRIZ DE DISE\303\221O --- */\n:root {\n  --color-vacio: #000000;\n  --color-cristal: rgba(7, 4, 23, 0.75);\n  --color-energia: #d6f421;\n  --color-furia: #fb5607;\n  --color-magia: #9600ff;\n}\n\n.font-anton {\n  font-family: \'Anton\', \'Outfit\', system-ui, sans-serif !important;\n}\n\n.accent-energy, .text-energy {\n  color: #d6f421 !important;\n}\n\n.bg-accent-energy, .bg-energy {\n  background-color: #d6f421 !important;\n  color: #000000 !important;\n}\n\n.border-energy {\n  border-color: #d6f421 !important;\n}\n\n.accent-furia, .text-furia {\n  color: #fb5607 !important;\n}\n\n.bg-accent-furia, .bg-furia {\n  background-color: #fb5607 !important;\n  color: #ffffff !important;\n}\n\n.border-furia {\n  border-color: #fb5607 !important;\n}\n\n.accent-magia, .text-magia {\n  color: #9600ff !important;\n}\n\n.bg-accent-magia, .bg-magia {\n  background-color: #9600ff !important;\n  color: #ffffff !important;\n}\n\n.border-magia {\n  border-color: #9600ff !important;\n}\n\n.glow-lime, .glow-energy {\n  box-shadow: 0 0 18px rgba(214, 244, 33, 0.45), inset 0 0 10px rgba(214, 244, 33, 0.15);\n}\n\n.glow-purple, .glow-magia {\n  box-shadow: 0 0 22px rgba(150, 0, 255, 0.55), inset 0 0 12px rgba(150, 0, 255, 0.2);\n}\n\n.glow-orange, .glow-furia {\n  box-shadow: 0 0 18px rgba(251, 86, 7, 0.45), inset 0 0 10px rgba(251, 86, 7, 0.15);\n}\n\n/* Glassmorphism Sci-Fi Matrix Tokens */\n.scifi-glass-panel {\n  background: rgba(7, 4, 23, 0.75) !important;\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(150, 0, 255, 0.4);\n  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.85);\n}\n\n.scifi-glass-modal {\n  background: rgba(4, 2, 14, 0.95) !important;\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border: 1px solid rgba(150, 0, 255, 0.6);\n  box-shadow: 0 0 50px rgba(150, 0, 255, 0.4);\n}\n\n/* Custom smooth scrollbar */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n::-webkit-scrollbar-track {\n  background: #000000;\n}\n::-webkit-scrollbar-thumb {\n  background: #9600ff;\n  border-radius: 4px;\n  border: 2px solid #000000;\n  box-shadow: 0 0 10px rgba(150, 0, 255, 0.6);\n}\n\n.custom-scrollbar::-webkit-scrollbar {\n  width: 4px;\n}\n.custom-scrollbar::-webkit-scrollbar-track {\n  background: rgba(7, 4, 23, 0.6);\n  border-radius: 4px;\n}\n.custom-scrollbar::-webkit-scrollbar-thumb {\n  background: rgba(214, 244, 33, 0.6);\n  border-radius: 4px;\n}\n.custom-scrollbar::-webkit-scrollbar-thumb:hover {\n  background: rgba(214, 244, 33, 0.9);\n}\n\n/* Juice Game Feel Keyframe Animations */\n@keyframes juiceFloatUp {\n  0% {\n    opacity: 0;\n    transform: translate(-50%, -50%) scale(0.6) translateY(0px);\n  }\n  15% {\n    opacity: 1;\n    transform: translate(-50%, -50%) scale(1.15) translateY(-10px);\n  }\n  80% {\n    opacity: 1;\n    transform: translate(-50%, -50%) scale(1) translateY(-45px);\n  }\n  100% {\n    opacity: 0;\n    transform: translate(-50%, -50%) scale(0.9) translateY(-65px);\n  }\n}\n\n@keyframes juiceCritPop {\n  0% {\n    opacity: 0;\n    transform: translate(-50%, -50%) scale(0.3) rotate(-8deg);\n  }\n  20% {\n    opacity: 1;\n    transform: translate(-50%, -50%) scale(1.4) rotate(4deg);\n  }\n  40% {\n    transform: translate(-50%, -50%) scale(1.1) rotate(-2deg);\n  }\n  85% {\n    opacity: 1;\n    transform: translate(-50%, -50%) scale(1) translateY(-50px);\n  }\n  100% {\n    opacity: 0;\n    transform: translate(-50%, -50%) scale(0.8) translateY(-75px);\n  }\n}\n\n@keyframes screenShakeLight {\n  0% { transform: translate(0, 0) rotate(0deg); }\n  20% { transform: translate(-2px, 2px) rotate(-0.5deg); }\n  40% { transform: translate(2px, -1px) rotate(0.5deg); }\n  60% { transform: translate(-1px, -2px) rotate(-0.5deg); }\n  80% { transform: translate(1px, 1px) rotate(0.5deg); }\n  100% { transform: translate(0, 0) rotate(0deg); }\n}\n\n.animate-juice-float {\n  animation: juiceFloatUp 0.95s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n  pointer-events: none;\n  will-change: transform, opacity;\n}\n\n.animate-juice-crit {\n  animation: juiceCritPop 1.1s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;\n  pointer-events: none;\n... (truncated)\n```\n\n--- /src/main.tsx ---\n```typescript\nimport { initializeStore } from \'./utils/storage\';\nimport {StrictMode} from \'react\';\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\nimport { AuthProvider } from \'./context/AuthContext\';\nimport { ErrorBoundary } from \'./components/ErrorBoundary\';\n\ninitializeStore();\nconst rootElement = document.getElementById(\'root\');\nif (rootElement) {\n  createRoot(rootElement).render(\n    <StrictMode>\n      <ErrorBoundary>\n        <AuthProvider>\n          <App />\n        </AuthProvider>\n      </ErrorBoundary>\n    </StrictMode>,\n  );\n}\n\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true,\n    \"types\": [\"vite/client\", \"vite-plugin-pwa/client\"]\n  }\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport { defineConfig } from \'vite\';\nimport { VitePWA } from \'vite-plugin-pwa\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [\n      react(), \n      tailwindcss(),\n      VitePWA({\n        registerType: \'autoUpdate\',\n        includeAssets: [\'favicon.ico\', \'apple-touch-icon.png\', \'icon.svg\'],\n        manifest: false,\n        workbox: {\n          globPatterns: [\'**/*.{js,css,html,ico,png,svg,webp,woff2}\'],\n          runtimeCaching: [\n            {\n              urlPattern: /^https:\\/\\/fonts\\.googleapis\\.com\\/.*/i,\n              handler: \'CacheFirst\',\n              options: {\n                cacheName: \'google-fonts-cache\',\n                expiration: { maxEntries: 10, maxAgeSeconds: 60 * 60 * 24 * 365 },\n                cacheableResponse: { statuses: [0, 200] },\n              },\n            },\n            {\n              urlPattern: /^https:\\/\\/fonts\\.gstatic\\.com\\/.*/i,\n              handler: \'CacheFirst\',\n              options: {\n                cacheName: \'gstatic-fonts-cache\',\n                expiration: { maxEntries: 10, maxAgeSeconds: 60 * 60 * 24 * 365 },\n                cacheableResponse: { statuses: [0, 200] },\n              },\n            },\n          ],\n        },\n        devOptions: {\n          enabled: false,\n        },\n      })\n    ],\n    build: {\n      outDir: \'dist\',\n      emptyOutDir: true,\n      chunkSizeWarningLimit: 1500,\n      rollupOptions: {\n        output: {\n          manualChunks(id) {\n            if (id.includes(\'node_modules\')) {\n              if (id.includes(\'firebase\')) {\n                return \'vendor-firebase\';\n              }\n              if (id.includes(\'recharts\') || id.includes(\'d3-\')) {\n                return \'vendor-charts\';\n              }\n              if (id.includes(\'lucide-react\') || id.includes(\'motion\') || id.includes(\'canvas-confetti\')) {\n                return \'vendor-ui\';\n              }\n              return \'vendor\';\n            }\n          },\n        },\n      },\n    },\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // File watching is disabled when DISABLE_HMR is true to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n\n```"
    items {

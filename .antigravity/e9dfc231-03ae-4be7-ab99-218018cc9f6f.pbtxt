          text: "// Selecciona UN SOLO JEFE ALEATORIO por d\303\255a (determinado por la fecha para consistencia diaria)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "export const getBossForDate = (dateStr: string): BossInfo => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  let hash = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  for (let i = 0; i < dateStr.length; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    hash = ((hash << 5) - hash) + dateStr.charCodeAt(i);"

        }
        lines {
          text: "                    const isInner = index < 4;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    const angleDeg = isInner ? INNER_ANGLES[index] : OUTER_ANGLES[index - 4];"

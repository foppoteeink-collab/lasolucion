        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Drone Low-pass Filter"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    this.droneFilter = this.ctx.createBiquadFilter();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    this.droneFilter.type = \'lowpass\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    this.droneFilter.frequency.value = 180;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    this.droneFilter.Q.value = 2.5;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // LFO to modulate filter cutoff for breathing spaceship cabin hum"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    this.droneLfo = this.ctx.createOscillator();"

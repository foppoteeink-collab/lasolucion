        }
        lines {
          text: "  const nowHour = new Date().getHours();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Time factor scales from 0 to 1 as the day progresses (maxing at 9:00 PM)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const timeFactor = Math.min(1, nowHour / 21);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const pendingCount = tasks.filter(t => !t.completed).length;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const totalCount = tasks.length || 1;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const pendingPercentage = pendingCount / totalCount;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // If completed all tasks, entropy is completely resolved (0%)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Otherwise, it is 60% based on pending tasks and 40% based on the time of day progression"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let systemEntropy = pendingCount === 0 ? 0 : Math.round((pendingPercentage * 60) + (timeFactor * 40));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  systemEntropy = Math.max(0, Math.min(100, systemEntropy));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }

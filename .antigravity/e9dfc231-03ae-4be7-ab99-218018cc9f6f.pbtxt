        lines {
          text: "                      const angleDeg = isInner ? INNER_ANGLES[index] : OUTER_ANGLES[index - 4];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const radius = isInner ? INNER_RADIUS : OUTER_RADIUS;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const angleRad = (angleDeg * Math.PI) / 180;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const x = radius * Math.cos(angleRad);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const y = -radius * Math.sin(angleRad);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const isHovered = hoveredActionId === item.id;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const lineDelay = isInner ? 0.04 + index * 0.045 : 0.2 + (index - 4) * 0.045;"

        }
        lines {
          text: "                      const angleRad = (angleDeg * Math.PI) / 180;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const x = radius * Math.cos(angleRad);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const y = -radius * Math.sin(angleRad);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }

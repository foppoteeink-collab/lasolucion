    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "rules_version = \'2\';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n    \n    function isOwner(userId) {\n      return isSignedIn() && request.auth.uid == userId;\n    }\n\n    function incoming() {\n      return request.resource.data;\n    }\n    \n    function existing() {\n      return resource.data;\n    }\n\n    function isValidPlayerStats() {\n      let data = incoming();\n      return (\n        (!(\'currentXp\' in data) || data.currentXp is number) &&\n        (!(\'coins\' in data) || data.coins is number) &&\n        (!(\'level\' in data) || data.level is number) &&\n        (!(\'hp\' in data) || data.hp is number)\n      );\n    }\n    \n    function isValidMutation() {\n      let currentXp = existing() == null || !(\'currentXp\' in existing()) ? 0 : existing().currentXp;\n      let newXp = !(\'currentXp\' in incoming()) ? 0 : incoming().currentXp;\n      let currentCoins = existing() == null || !(\'coins\' in existing()) ? 0 : existing().coins;\n      let newCoins = !(\'coins\' in incoming()) ? 0 : incoming().coins;\n      \n      let diffXp = newXp - currentXp;\n      let diffCoins = newCoins - currentCoins;\n      \n      // Bloqueamos mutaciones an\303\263malas (Client Exploitation/Data Poisoning)\n      return diffXp <= 5000 && diffCoins <= 5000;\n    }\n\n    match /users/{userId} {\n      allow read: if isOwner(userId);\n      allow create: if isOwner(userId) && isValidPlayerStats();\n      allow update: if isOwner(userId) && isValidPlayerStats() && isValidMutation();\n\n      match /{allSubcollections=**} {\n        allow read, write: if isOwner(userId);\n      }\n    }\n  }\n}\n"
    }

    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  // Escuchar cuando se completan tareas o se logran victorias\n  const prevCompletedRef = useRef(completedTodayTasks);\n  useEffect(() => {\n    if (completedTodayTasks > prevCompletedRef.current) {\n      setHasRecentVictory(true);\n      showThought(\'\302\241Misi\303\263n cumplida! Tu voluntad altera el destino.\');\n      soundFX.playLevelUp();\n      const timer = setTimeout(() => setHasRecentVictory(false), 3500);\n      return () => clearTimeout(timer);\n    }\n    prevCompletedRef.current = completedTodayTasks;\n  }, [completedTodayTasks]);\n\n  // Mostrar un pensamiento espor\303\241dico\n  const showThought = (customText?: string) => {\n    const text = customText || WISDOM_MICRO_THOUGHTS[Math.floor(Math.random() * WISDOM_MICRO_THOUGHTS.length)];\n    setCurrentThought(text);\n    setThoughtVisible(true);\n  };\n\n  // Temporizador para pensamientos espor\303\241dicos autom\303\241ticos\n  useEffect(() => {\n    const firstTimer = setTimeout(() => {\n      if (!isPomodoroOpen) {\n        showThought();\n      }\n    }, 8000);\n\n    const interval = setInterval(() => {\n      if (!isMenuOpen) {\n        if (isPomodoroOpen || isTimerRunning) {\n          showThought(\'Modo Hiperenfoque activo: mant\303\251n el flujo y respira con mi pulso.\');\n        } else if (isStreakAtRisk) {\n          showThought(\'Detecto desalineaci\303\263n en tus h\303\241bitos... Conquista una tarea hoy.\');\n        } else {\n          showThought();\n        }\n      }\n    }, 55000);\n\n    return () => {\n      clearTimeout(firstTimer);\n      clearInterval(interval);\n    };\n  }, [isPomodoroOpen, isTimerRunning, isStreakAtRisk, isMenuOpen]);\n\n  // Auto-ocultar el pensamiento despu\303\251s de 7 segundos\n  useEffect(() => {\n    if (thoughtVisible) {\n      const hideTimer = setTimeout(() => {\n        setThoughtVisible(false);\n      }, 7000);\n      return () => clearTimeout(hideTimer);\n    }\n  }, [thoughtVisible]);"
      replacement_content: "  // Escuchar cuando se completan tareas o se logran victorias (aura reactiva y sonido, sin invadir la pantalla con texto)\n  const prevCompletedRef = useRef(completedTodayTasks);\n  useEffect(() => {\n    if (completedTodayTasks > prevCompletedRef.current) {\n      setHasRecentVictory(true);\n      soundFX.playLevelUp();\n      const timer = setTimeout(() => setHasRecentVictory(false), 3500);\n      return () => clearTimeout(timer);\n    }\n    prevCompletedRef.current = completedTodayTasks;\n  }, [completedTodayTasks]);"
    }

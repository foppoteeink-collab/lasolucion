  const saved = safeGetItem(LOCAL_STORAGE_KEY);\\n      if (saved) {\\n        const p = JSON.parse(saved);\\n        if (p.targetEndTime && p.isRunning) {\\n          const now = Date.now();\\n          if (p.targetEndTime > now) {\\n            setTargetEndTime(p.targetEndTime);\\n            setTimeLeft(Math.ceil((p.targetEndTime - now) / 1000));\\n            setIsRunning(true);\\n            setFocusModeActive(true);\\n          } else {\\n            setTimeLeft(0);\\n            setIsRunning(false);\\n            setFocusModeActive(false);\\n          }\\n        } else {\\n          if (p.timeLeft) setTimeLeft(p.timeLeft);\\n        }\\n        if (p.mode) setMode(p.mode);\\n        if (p.taskTitle) setTaskTitle(p.taskTitle);\\n        if (p.initialTimeLeft) setInitialTimeLeft(p.initialTimeLeft);\\n        if (p.completedPomodorosToday) setCompletedPomodorosToday(p.completedPomodorosToday);\\n      }\\n    } catch (e) {}\\n  }, []);\\n\\n  // Save to local storage whenever state changes\\n  useEffect(() => {\\n    if (!isRunning) {\\n      safeSetItem(LOCAL_STORAGE_KEY, JSON.stringify({\\n        mode,\\n        taskTitle,\\n        category,\\n        initialTimeLeft,\\n        timeLeft,\\n        isRunning,\\n        targetEndTime,\\n        completedPomodorosToday\\n      }));\\n    }\\n  }, [mode, taskTitle, category, initialTimeLeft, timeLeft, isRunning, targetEndTime, completedPomodorosToday]);\\n\\n  const handleFinishTimer = useCallback(() => {\\n    setIsRunning(false);\\n    setTargetEndTime(null);\\n    setFocusModeActive(false);\\n    safeSetItem(LOCAL_STORAGE_KEY, \\\"\\\");\\n    \\n    // Si termin\303\263 un pomodoro de trabajo\", \"TargetContent\":\"  useEffect(() => {\\n    try {\\n      const saved = safeGetItem(LOCAL_STORAGE_KEY);\\n      if (saved) {\\n        const parsed = JSON.parse(saved);\\n        if (parsed.mode) setMode(parsed.mode);\\n        if (parsed.taskTitle) setTaskTitle(parsed.taskTitle);\\n        if (parsed.initialTimeLeft) setInitialTimeLeft(parsed.initialTimeLeft);\\n        if (parsed.timeLeft) setTimeLeft(parsed.timeLeft);\\n        if (parsed.completedPomodorosToday) setCompletedPomodorosToday(parsed.completedPomodorosToday);\\n      }\\n    } catch (e) {}\\n  }, []);\\n\\n  // Save to local storage whenever state changes\\n  useEffect(() => {\\n    safeSetItem(LOCAL_STORAGE_KEY, JSON.stringify({\\n      mode,\\n      taskTitle,\\n      category,\\n      initialTimeLeft,\\n      timeLeft,\\n      completedPomodorosToday\\n    }));\\n  }, [mode, taskTitle, category, initialTimeLeft, timeLeft, completedPomodorosToday]);\\n\\n  const handleFinishTimer = useCallback(() => {\\n    setIsRunning(false);\\n    \\n    // Si termin\303\263 un pomodoro de trabajo\"}, {\"ReplacementContent\":\"  // Main Timer loop\\n  useEffect(() => {\\n    let intervalId: any;\\n    if (isRunning && targetEndTime) {\\n      intervalId = setInterval(() => {\\n        const now = Date.now();\\n        const rem = Math.max(0, Math.ceil((targetEndTime - now) / 1000));\\n        setTimeLeft(rem);\\n        \\n        if (rem <= 0) {\\n          handleFinishTimer();\\n        }\\n      }, 500);\\n    }\\n    return () => clearInterval(intervalId);\\n  }, [isRunning, targetEndTime, handleFinishTimer]);\\n\\n  const togglePlay = () => {\\n    soundFX.playClick();\\n    if (!isRunning) {\\n      const target = Date.now() + timeLeft * 1000;\\n      setTargetEndTime(target);\\n      setIsRunning(true);\\n      setFocusModeActive(true);\\n      safeSetItem(LOCAL_STORAGE_KEY, JSON.stringify({ mode, taskTitle, category, initialTimeLeft, timeLeft, isRunning: true, targetEndTime: target, completedPomodorosToday }));\\n    } else {\\n      setIsRunning(false);\\n      setTargetEndTime(null);\\n      setFocusModeActive(false);\\n    }\\n  };\\n\\n  const resetTimer = () => {\\n    soundFX.playClick();\\n    setIsRunning(false);\\n    setTargetEndTime(null);\\n    setFocusModeActive(false);\\n    setTimeLeft(initialTimeLeft);\\n  };\\n\\n  const switchMode = (newMode: PomodoroMode) => {\\n    soundFX.playClick();\\n    setIsRunning(false);\\n    setTargetEndTime(null);\\n    setFocusModeActive(false);\\n    setMode(newMode);\\n    const newDur = newMode === \'work\' ? WORK_TIME : newMode === \'short_break\' ? SHORT_BREAK : LONG_BREAK;\\n    setInitialTimeLeft(newDur);\\n    setTimeLeft(newDur);\\n  };\", \"TargetContent\":\"  // Main Timer loop\\n  useEffect(() => {\\n    let intervalId: any;\\n    if (isRunning) {\\n      intervalId = setInterval(() => {\\n        setTimeLeft((prev) => {\\n          if (prev <= 1) {\\n            handleFinishTimer();\\n            return 0;\\n          }\\n          return prev - 1;\\n        });\\n      }, 1000);\\n    }\\n    return () => clearInterval(intervalId);\\n  }, [isRunning, handleFinishTimer]);\\n\\n\\n  const togglePlay = () => {\\n    soundFX.playClick();\\n    setIsRunning(prev => !prev);\\n  };\\n\\n  const resetTimer = () => {\\n    soundFX.playClick();\\n    setIsRunning(false);\\n    setTimeLeft(initialTimeLeft);\\n  };\\n\\n  const switchMode = (newMode: PomodoroMode) => {\\n    soundFX.playClick();\\n    setIsRunning(false);\\n    setMode(newMode);\\n    const newDur = newMode === \'work\' ? WORK_TIME : newMode === \'short_break\' ? SHORT_BREAK : LONG_BREAK;\\n    setInitialTimeLeft(newDur);\\n    setTimeLeft(newDur);\\n  };\"}, {\"ReplacementContent\":\"      targetEndTime,\\n      completedPomodorosToday,\", \"TargetContent\":\"      completedPomodorosToday,\"}], \"TargetFile\":\"/src/context/TimerContext.tsx\", \"toolAction\":\"Modifying TimerContext\", \"toolSummary\":\"Modify TimerContext\"}"

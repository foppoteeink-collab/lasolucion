        }
        lines {
          text: "  const [isCollapsed, setIsCollapsed] = useState(false);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [bossMode, setBossMode] = useState<\'daily\' | \'weekly\'>(\'daily\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const activeDate = currentDate || getTodayDateString();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const dailyBoss = getBossForDate(activeDate);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const boss = bossMode === \'daily\' ? dailyBoss : WEEKLY_RAID_BOSS;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // Calculate Boss HP based on task completion"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const totalTasks = tasks.length || 1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const completedTasks = tasks.filter((t) => t.completed).length;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // Weakness bonus damage calculation"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const completedWeaknessCount = tasks.filter((t) => t.completed && (t.category === boss.weaknessCategory || ((boss.weaknessCategory === \'creativo\' || boss.weaknessCategory === \'pomodoro\') && (t.category === \'creativo\' || t.category === \'estudio\')))).length;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // Normal tasks do baseline damage, weakness tasks do 1.5x damage"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  let currentHp = 100;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (bossMode === \'daily\') {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const rawDamage = (completedTasks / totalTasks) * 100 + (completedWeaknessCount * 4);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    currentHp = Math.max(0, Math.min(100, Math.round(100 - rawDamage)));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  } else {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Weekly raid boss calculation"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const weeklyDamage = (completedTasks * 40) + (completedWeaknessCount * 60);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    currentHp = Math.max(0, Math.min(100, Math.round(100 - (weeklyDamage / 10))));"

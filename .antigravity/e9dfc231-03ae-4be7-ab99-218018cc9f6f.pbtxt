        lines {
          text: "                          key={`laser-${item.id}`}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          x1=\"0\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          y1=\"0\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          x2={x}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          y2={y}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          stroke={item.accentColor}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          strokeOpacity={isHovered ? 0.95 : 0.35}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          strokeWidth={isHovered ? 2 : 1.2}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          strokeDasharray={isHovered ? \'none\' : isInner ? \'3 3\' : \'4 4\'}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          initial={{ pathLength: 0, opacity: 0 }}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          animate={{ pathLength: 1, opacity: 1 }}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          exit={{ pathLength: 0, opacity: 0, transition: { duration: 0.18, ease: \'easeIn\' } }}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          transition={{ duration: 0.4, delay: lineDelay, ease: [0.16, 1, 0.3, 1] }}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }

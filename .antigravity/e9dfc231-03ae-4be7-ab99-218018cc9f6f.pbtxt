      replacement_content: "  const setIsNightlyReflectionOpen = (v: boolean) => setModalState(\'isNightlyReflectionOpen\', v);\n  \n  const handleConfirmFinishDayLocal = (bonusXp: number, bonusCoins: number) => {\n    const today = getTodayDateString();\n    const now = new Date();\n    const timeString = now.toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' });\n    \n    usePlayerStore.getState().finalizeDay(today, bonusXp, bonusCoins, timeString);\n    useTaskStore.getState().lockTasksForDate(today);\n    \n    if (bonusXp > 0 || bonusCoins > 0) {\n      if (typeof window !== \'undefined\') {\n        const stateUI = useUIStore.getState();\n        stateUI.addFloatingEffect({ x: window.innerWidth / 2, y: window.innerHeight / 2 - 20, text: `+${bonusXp} XP`, type: \'xp\' });\n        setTimeout(() => {\n          stateUI.addFloatingEffect({ x: window.innerWidth / 2, y: window.innerHeight / 2 - 40, text: `+${bonusCoins} Oro`, type: \'coins\' });\n        }, 150);\n      }\n    }\n  };\n\n  const [isGlowing, setIsGlowing] = React.useState(false);"
    }
    instruction: "Provide local handleConfirmFinishDay"
  }
}

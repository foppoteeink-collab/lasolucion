ping\" />\n            )}\n            {showSoundscapeConsole ? (\n              <ChevronUp className=\"w-3.5 h-3.5 text-cyan-400\" />\n            ) : (\n              <ChevronDown className=\"w-3.5 h-3.5 text-slate-400\" />\n            )}\n          </button>\n        </div>\n\n        {/* Alarm Testing & Rewards */}\n        <div className=\"flex items-center justify-between sm:justify-end gap-3 text-[11px] text-slate-400 border-t sm:border-t-0 border-cyan-900/40 pt-2 sm:pt-0\">\n          <div className=\"flex items-center gap-2 font-mono\">\n            <span className=\"flex items-center gap-1 text-cyan-400 font-bold\">\n              <Zap className=\"w-3 h-3\" /> +25 XP\n            </span>\n            <span className=\"flex items-center gap-1 text-amber-400 font-bold\">\n              <Coins className=\"w-3 h-3\" /> +8 Monedas\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-1.5\">\n            <span className=\"text-slate-500 text-[10px] hidden lg:inline font-mono\">Alarmas:</span>\n            <button\n              type=\"button\"\n              onClick={handleTestWorkAlarm}\n              className=\"px-2 py-0.5 rounded-lg bg-[#000a14] hover:bg-cyan-950/60 border border-cyan-500/40 hover:border-cyan-400 text-cyan-300 text-[10px] font-bold transition cursor-pointer flex items-center gap-1\"\n              title=\"Probar sonido de alarma de 25m\"\n            >\n              <Bell className=\"w-3 h-3 text-cyan-400\" />\n              <span>25m</span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={handleTestBreakAlarm}\n              className=\"px-2 py-0.5 rounded-lg bg-[#000a14] hover:bg-emerald-950/60 border border-emerald-500/40 hover:border-emerald-400 text-emerald-300 text-[10px] font-bold transition cursor-pointer flex items-center gap-1\"\n              title=\"Probar sonido de alarma de 5m\"\n            >\n              <Zap className=\"w-3 h-3 text-emerald-400\" />\n              <span>5m</span>\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Quantum Soundscape Console Drawer */}\n      {showSoundscapeConsole && (\n        <div className=\"mt-4 pt-3 border-t border-cyan-500/30 animate-in fade-in slide-in-from-top-2 duration-300\">\n          <QuantumSoundscapeConsole />\n        </div>\n      )}"

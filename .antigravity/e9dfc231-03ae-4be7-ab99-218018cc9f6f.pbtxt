    replacement_infos {
      original_chunk {
        target_content: "    } catch (err: any) {\n      let errMsg = err.message || \'Error de compilaci\303\263n en el N\303\272cleo Central.\';\n      try {\n        const parsed = JSON.parse(errMsg);\n        if (parsed?.error?.message) errMsg = parsed.error.message;\n      } catch {}\n      if (errMsg.includes(\'429\') || errMsg.toLowerCase().includes(\'quota\') || errMsg.toLowerCase().includes(\'resource_exhausted\')) {\n        errMsg = \'L\303\255mite de solicitudes de IA alcanzado temporalmente. El N\303\272cleo Local est\303\241 disponible con total precisi\303\263n.\';\n      } else if (errMsg.includes(\'503\') || errMsg.toLowerCase().includes(\'high demand\') || errMsg.toLowerCase().includes(\'unavailable\')) {\n        errMsg = \'Los servidores de IA est\303\241n saturados temporalmente por alta demanda mundial. Puedes reintentar con el bot\303\263n de abajo.\';\n      }\n      setError(errMsg);\n      soundFX.playGlitch();\n    } finally {"
        replacement_content: "    } catch (err: any) {\n      console.warn(\"API request failed, falling back to local procedural heuristics:\", err);\n      // Fallback directly to procedural heuristics so it works seamlessly on Netlify / offline\n      try {\n        const fallbackHabits = generateProceduralSchedule(\n          textToUse, \n          {\n            profession: stats?.profession, \n            mantra: stats?.mantra, \n            bio: stats?.bio, \n            age: stats?.age, \n            mainGoal: stats?.mainGoal, \n            class: stats?.characterClass, \n            rank: stats?.rankTitle, \n            name: stats?.fullName \n          }, \n          scheduleMode\n        );\n        setNotice(\"Agenda estructurada exitosamente por el N\303\272cleo Heur\303\255stico Aut\303\263nomo.\");\n        const seenTitles = new Set<string>();\n        const processed = fallbackHabits.filter(h => {\n          if (isQuickMicroHabit(h)) return false;\n          const key = (h.title || \'\').trim().toLowerCase();\n          if (!key || seenTitles.has(key)) return false;\n          seenTitles.add(key);\n          return true;\n        });\n        setSuggestedHabits(sortByChronologicalTime(processed));\n        setAddedHabitIds(new Set());\n        soundFX.playSubBassConfirm();\n        setError(null);\n      } catch (fallbackErr) {\n        let errMsg = err.message || \'Error de compilaci\303\263n en el N\303\272cleo Central.\';\n        setError(errMsg);\n        soundFX.playGlitch();\n      }\n    } finally {"
      }

        lines {
          text: "                            duration: 0.55,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            ease: [0.16, 1, 0.3, 1], // Misma curva cinem\303\241tica fluida de las p\303\241ginas"

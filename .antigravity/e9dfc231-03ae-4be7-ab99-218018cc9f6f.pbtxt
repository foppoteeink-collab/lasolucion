          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // PILAR B: MEDIDOR DE ENTROP\303\215A DETERMINISTA (Alineado con Opci\303\263n 3)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // -------------------------------------------------------------"

        replacement_content: "    // Bloqueo: Si la jornada ya fue finalizada manualmente por el usuario.\n    // Implementamos \"Zero Friction Grace Period\": ya no bloqueamos d\303\255as pasados autom\303\241ticamente, \n    // permitiendo registro retroactivo. Solo bloqueamos si el usuario cerr\303\263 el d\303\255a expl\303\255citamente.\n    const playerStats = usePlayerStore.getState().stats;\n    const isFinalized = Boolean(playerStats?.finalizedDays?.[date]);\n    if (isFinalized && !targetTask.completed) {\n      return state;\n    }"
      }
      num_matches: 1
    }
  }

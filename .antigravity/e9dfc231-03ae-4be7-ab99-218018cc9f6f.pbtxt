    instruction: "Refactor handleRedeem and buyStreakShield in RewardShop to use purchaseItem"
    replacement_infos {
      original_chunk {
        target_content: "  const handleRedeem = (reward: ShopReward) => {\n    const finalCost = getDiscountedCost(reward);\n    if (coins < finalCost) return;\n    \n    // Apply specific perk effects\n    if (reward.id === \'perk-healing-potion\') {\n      heal(30);\n      triggerScreenFlash(\'heal\');\n      triggerHaptic([100]);\n      notificationService.triggerNotification(\'\302\241HP Restaurado! \360\237\222\226\', \'Te has curado 30 puntos de vida usando una Poci\303\263n de Curaci\303\263n Mayor.\', \'\360\237\222\226\');\n    }\n    if (reward.id === \'perk-streak-shield\') {\n      setStats(prev => ({ ...prev, streakShields: (prev.streakShields || 0) + 1 }));\n    }\n\n    // Deduct coins\n    setStats(prev => ({\n      ...prev,\n      coins: Math.max(0, prev.coins - finalCost)\n    }));\n\n    // Update reward count\n    setShopRewards((prev: ShopReward[]) => \n      prev.map(r => r.id === reward.id ? { ...r, unlockedCount: (r.unlockedCount || 0) + 1 } : r)\n    );\n\n    soundFX.playCoin();\n    soundFX.playSubBassConfirm();\n    try {\n      confetti({\n        particleCount: 60,\n        spread: 60,\n        origin: { y: 0.7 },\n        colors: [\'#FBBF24\', \'#34D399\', \'#60A5FA\']\n      });\n    } catch {\n      // ignore\n    }\n  };\n\n  const buyStreakShield = () => {\n    if (coins < 100) return;\n    setStats(prev => ({\n      ...prev,\n      coins: prev.coins - 100,\n      streakShields: (prev.streakShields || 0) + 1\n    }));\n    soundFX.playLevelUp();\n    try {\n      confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });\n    } catch (e) {}\n  };"
        replacement_content: "  const handleRedeem = (reward: ShopReward) => {\n    const finalCost = getDiscountedCost(reward);\n    \n    // Transacci\303\263n At\303\263mica\n    const success = usePlayerStore.getState().purchaseItem(finalCost, (prev) => {\n      let extra = {};\n      if (reward.id === \'perk-healing-potion\') {\n        extra = { hp: Math.min(prev.maxHp || 100, (prev.hp ?? 100) + 30) };\n      }\n      if (reward.id === \'perk-streak-shield\') {\n        extra = { streakShields: (prev.streakShields || 0) + 1 };\n      }\n      return extra;\n    });\n\n    if (!success) return;\n\n    if (reward.id === \'perk-healing-potion\') {\n      triggerScreenFlash(\'heal\');\n      triggerHaptic([100]);\n      notificationService.triggerNotification(\'\302\241HP Restaurado! \360\237\222\226\', \'Te has curado 30 puntos de vida usando una Poci\303\263n de Curaci\303\263n Mayor.\', \'\360\237\222\226\');\n    }\n\n    // Update reward count\n    setShopRewards((prev: ShopReward[]) => \n      prev.map(r => r.id === reward.id ? { ...r, unlockedCount: (r.unlockedCount || 0) + 1 } : r)\n    );\n\n    soundFX.playCoin();\n    soundFX.playSubBassConfirm();\n    try {\n      confetti({\n        particleCount: 60,\n        spread: 60,\n        origin: { y: 0.7 },\n        colors: [\'#FBBF24\', \'#34D399\', \'#60A5FA\']\n      });\n    } catch {\n      // ignore\n    }\n  };\n\n  const buyStreakShield = () => {\n    const success = usePlayerStore.getState().purchaseItem(100, (prev) => ({\n      streakShields: (prev.streakShields || 0) + 1\n    }));\n    \n    if (!success) return;\n\n    soundFX.playLevelUp();\n    try {\n      confetti({ particleCount: 100, spread: 70, origin: { y: 0.6 } });\n    } catch (e) {}\n  };"
      }
      num_matches: 1
    }
  }
}
